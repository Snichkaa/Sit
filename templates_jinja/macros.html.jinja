{% macro table(title, columns, rows) -%}
<div class="card mb-4">
  <div class="card-header d-flex justify-content-between align-items-center">
    <strong>{{ title }}</strong>
    <span class="text-muted small">Показано: {{ rows|length }}</span>
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-striped table-hover mb-0">
        <thead class="table-light">
          <tr>
            {% for col in columns %}
              <th>{{ col }}</th>
            {% endfor %}
          </tr>
        </thead>
        <tbody>
          {% for row in rows %}
            <tr>
              {% for cell in row %}
                <td>{{ cell }}</td>
              {% endfor %}
            </tr>
          {% else %}
            <tr><td colspan="{{ columns|length }}" class="text-muted">Нет данных</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</div>
{%- endmacro %}
