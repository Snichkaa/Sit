{% extends "base.html.jinja" %}
{% block title %}Игры — CRUD{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="mb-0">Игры (CRUD через Django Forms)</h1>
  <a class="btn btn-primary" href="{{ url('game_add') }}">Добавить игру</a>
</div>

<form class="row g-2 mb-3" method="get">
  <div class="col-sm-10">
    <input class="form-control" name="q" value="{{ request.GET.get('q','') }}" placeholder="Поиск по названию..." />
  </div>
  <div class="col-sm-2 d-grid">
    <button class="btn btn-outline-secondary" type="submit">Найти</button>
  </div>
</form>

<div class="table-responsive">
  <table class="table table-striped table-hover align-middle">
    <thead class="table-light">
      <tr>
        <th>Название</th>
        <th>Год</th>
        <th>Платформа</th>
        <th>Жанр</th>
        <th>Издатель</th>
        <th class="text-end">Действия</th>
      </tr>
    </thead>
    <tbody>
      {% for g in games %}
        <tr>
          <td>{{ g.name }}</td>
          <td>{{ g.year_of_release or "" }}</td>
          <td>{{ g.platform.code }}</td>
          <td>{{ g.genre.name }}</td>
          <td>{{ g.publisher.name if g.publisher else "—" }}</td>
          <td class="text-end">
            <a class="btn btn-sm btn-outline-primary" href="{{ url('game_edit', pk=g.id) }}">Редактировать</a>
            <a class="btn btn-sm btn-outline-danger" href="{{ url('game_delete', pk=g.id) }}">Удалить</a>
          </td>
        </tr>
      {% else %}
        <tr><td colspan="6" class="text-muted">Нет данных</td></tr>
      {% endfor %}
    </tbody>
  </table>
</div>

<nav class="mt-3">
  <ul class="pagination">
    {% if page_obj.has_previous %}
      <li class="page-item">
        <a class="page-link" href="?page={{ page_obj.previous_page_number() }}&q={{ request.GET.get('q','') }}">Назад</a>
      </li>
    {% endif %}
    <li class="page-item disabled"><span class="page-link">Страница {{ page_obj.number }} / {{ page_obj.paginator.num_pages }}</span></li>
    {% if page_obj.has_next %}
      <li class="page-item">
        <a class="page-link" href="?page={{ page_obj.next_page_number() }}&q={{ request.GET.get('q','') }}">Вперёд</a>
      </li>
    {% endif %}
  </ul>
</nav>
{% endblock %}
